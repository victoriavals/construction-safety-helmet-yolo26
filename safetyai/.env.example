# URL backend FastAPI (Hugging Face Space) untuk deteksi helm.
# Tanpa garis miring di akhir. Contoh:
#   VITE_API_BASE=https://namauser-deteksi-helm-api.hf.space
# Uji lokal backend:
#   VITE_API_BASE=http://localhost:7860
#
# Catatan: alternatifnya kamu bisa mengatur window.API_BASE di public/config.js
# (override runtime, bisa diubah tanpa build ulang). public/config.js menang
# bila keduanya diisi.
VITE_API_BASE=
